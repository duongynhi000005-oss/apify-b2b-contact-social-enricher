            "title": "title"
          },
          "emails": {
            "type": "string",
            "title": "emails"
          },
          "phones": {
            "type": "string",
            "title": "phones"
          },
          "linkedin": {
            "type": "string",
            "title": "linkedin"
          },
          "twitter": {
            "type": "string",
            "title": "twitter"
